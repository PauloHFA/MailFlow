APP_ENV=development
LOG_LEVEL=INFO
TEST_RECIPIENT_ALLOWLIST=qa@example.com
POSTGRES_DB=mailflow
POSTGRES_USER=mailflow
POSTGRES_PASSWORD=replace-with-a-local-development-password
SMTP_HOST=mailpit
SMTP_PORT=1025
DEFAULT_FROM_EMAIL=MailFlow <no-reply@mailflow.local>
PROVIDER_RATE_PER_SECOND=10
PROVIDER_DAILY_LIMIT=10000
RECIPIENT_DOMAIN_RATE_PER_SECOND=5
RECIPIENT_DOMAIN_DAILY_LIMIT=5000
WORKER_MAX_ATTEMPTS=5
RETRY_BACKOFF_BASE_SECONDS=2
PROCESSING_VISIBILITY_TIMEOUT_SECONDS=300
WARMUP_ENABLED=false
WARMUP_DAILY_LIMIT=500
WARMUP_DOMAIN_DAILY_LIMIT=50
REPUTATION_BOUNCE_THRESHOLD=0.05
REPUTATION_COMPLAINT_THRESHOLD=0.001
